#copy to data-download/.env and fill in. .env is gitignored, never commit real
#credentials.
#env vars win over this file. Sources missing their secrets are skipped, not
#failed.

#wrds_crsp, required
#WRDS login, for CRSP daily index returns
#https://wrds-www.wharton.upenn.edu/
WRDS_USERNAME=
WRDS_PASSWORD=

#cboe, optional
#override the CBOE base URL, or leave unset for the default
CBOE_BASE_URL=
